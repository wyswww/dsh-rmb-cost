{
  "name": "dsh-rmb-cost",
  "version": "0.1.3",
  "description": "Current-session DeepSeek token cost estimate in CNY",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "engine.js",
    "client.js",
    "pricing.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "external": [
        "react"
      ]
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyswww/dsh-rmb-cost.git"
  },
  "homepage": "https://github.com/wyswww/dsh-rmb-cost#readme",
  "bugs": {
    "url": "https://github.com/wyswww/dsh-rmb-cost/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "token",
    "cost",
    "cny"
  ]
}
